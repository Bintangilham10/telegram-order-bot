# === Boslay Order Bot — Direct Buy + Manual QRIS ===

# --- Server ---
PORT=3000
DATA_DIR=./data

# --- URLs (ganti dengan domain kamu) ---
API_BASE_URL=https://api.domainmu.com
ADMIN_APP_ORIGIN=https://admin.domainmu.com

# --- Telegram Bot ---
BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=random-secret-string-here

# --- Admin Panel ---
ADMIN_PANEL_PASSWORD=your-strong-password-here
ADMIN_SESSION_SECRET=random-64-char-secret-here

# --- Admin Telegram Notifications ---
ADMIN_ID=123456789

# --- Manual Payment: QRIS Merchant ---
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_METHOD_NAME=QRIS
MANUAL_PAYMENT_ACCOUNT_NAME=Boslay Store
# Path is private under DATA_DIR/uploads; it is not served publicly.
MANUAL_PAYMENT_QRIS_IMAGE=/uploads/payment/qris.png
MANUAL_PAYMENT_INSTRUCTIONS=Bayar sesuai nominal lalu kirim bukti pembayaran.
ORDER_EXPIRY_MINUTES=60
