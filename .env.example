# === Ciganstore Order Bot — Wallet Checkout + Manual GoPay Top Up ===

# --- Server ---
PORT=3000
DATA_DIR=./data
# Hanya aktifkan jika server selalu berada di belakang reverse proxy tepercaya.
TRUST_PROXY=false
# Default 50 MB; rentang valid 1 KB sampai 250 MB.
MAX_DIGITAL_FILE_BYTES=52428800

# --- URLs (ganti dengan domain kamu) ---
API_BASE_URL=https://api.domainmu.com
ADMIN_APP_ORIGIN=https://admin.domainmu.com

# --- Telegram Bot ---
BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=random-secret-string-here

# --- Admin Panel ---
# Buat dengan: npm run security:hash-password --workspace @belugaw/server
ADMIN_PANEL_PASSWORD_HASH=generate-with-security-hash-password-command
ADMIN_SESSION_SECRET=random-64-char-secret-here
# Gunakan None hanya jika panel admin benar-benar berada di site/domain berbeda.
ADMIN_COOKIE_SAME_SITE=Strict

# --- Admin Telegram Notifications ---
ADMIN_ID=123456789

# --- Manual GoPay Wallet Top Up ---
# Nama variabel MANUAL_PAYMENT_* dipertahankan untuk kompatibilitas.
MANUAL_PAYMENT_ENABLED=true
MANUAL_PAYMENT_METHOD_NAME=GoPay Merchant QR
MANUAL_PAYMENT_ACCOUNT_NAME=Ciganstore
# Path is private under DATA_DIR/uploads; it is not served publicly.
MANUAL_PAYMENT_QRIS_IMAGE=/uploads/payment/qris.png
MANUAL_PAYMENT_INSTRUCTIONS=Bayar sesuai nominal top up lalu kirim bukti pembayaran.
ORDER_EXPIRY_MINUTES=60

